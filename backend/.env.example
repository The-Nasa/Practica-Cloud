# Application Environment
NODE_ENV=development
PORT=3000

# PostgreSQL 17 Database Connection
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_USER=quickly_user
DATABASE_PASSWORD=GENERATE_WITH_DEV_SETUP
DATABASE_NAME=quickly_db
DATABASE_URL=postgresql://quickly_user:GENERATE_WITH_DEV_SETUP@127.0.0.1:5433/quickly_db

# PostgreSQL separado para harness. Nunca apuntar a quickly_db.
TEST_DATABASE_PORT=15432
TEST_DATABASE_PASSWORD=GENERATE_WITH_DEV_SETUP
TEST_DATABASE_URL=postgresql://quickly_test:GENERATE_WITH_DEV_SETUP@127.0.0.1:15432/postgres

# Security & Sessions
# Cookie HttpOnly; false solo para HTTP local. Usar true con HTTPS en despliegue.
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=72
AUTH_RATE_LIMIT=30
COURIER_FEE_BPS=8000

# CORS (Frontend origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Local object adapter. Relative to the API working directory; persist with the DB.
# Tests replace this with a unique temporary directory; do not point tests at .media.
MEDIA_ROOT=.media

# New cash orders expire if still pending; 0 keeps new orders under manual handling.
PENDING_ORDER_TTL_MINUTES=15
# In-process worker interval. 0 disables the timer; orders:expire remains available.
ORDER_EXPIRATION_INTERVAL_SECONDS=30

# Internal notifications from durable outbox; 0 disables the interval.
NOTIFICATION_INTERVAL_SECONDS=30

# F8: one trusted reverse proxy only; leave 0 for direct local API.
TRUST_PROXY_HOPS=0
HTTP_ACCESS_LOG=false
PG_POOL_MAX=20
PG_CONNECT_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=15000
PG_IDLE_TRANSACTION_TIMEOUT_MS=15000

# Google OAuth 2.0 (Google Sign-In)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Email Service (Verification codes & Notifications)
# If left empty, verification codes are logged to the dev console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=soporte@quickly.pe
SMTP_PASS=your-app-password
SMTP_FROM="Quickly Delivery" <soporte@quickly.pe>

