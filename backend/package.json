{
  "name": "quickly-backend",
  "version": "1.0.0",
  "description": "Quickly Delivery Platform Backend - Modular Monolith with Clean Architecture and 3FN PostgreSQL",
  "author": "Quickly Team",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "contracts:export": "node scripts/export-openapi.cjs",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "node test/run-e2e.cjs",
    "harness:check": "node test/harness-check.cjs",
    "harness:docker": "node scripts/harness-docker.cjs",
    "harness:browser": "node scripts/harness-docker.cjs --browser",
    "harness:full": "node scripts/harness-docker.cjs --full",
    "dev:setup": "node scripts/setup-dev.cjs",
    "dev:db": "node scripts/start-dev-db.cjs",
    "db:migrate": "node scripts/migrate.cjs",
    "db:seed": "node scripts/seed-initial.cjs",
    "media:cleanup": "node scripts/media-cleanup.cjs",
    "orders:expire": "node scripts/expire-orders.cjs",
    "test:f4": "node scripts/harness-docker.cjs --suite=f4",
    "test:f4:browser": "node scripts/harness-docker.cjs --browser --spec=original-integral.spec.ts",
    "admin:bootstrap": "node scripts/bootstrap-admin.cjs",
    "dev:db:stop": "docker compose stop postgres",
    "db:inspect": "node scripts/db-inspect.cjs",
    "db:verify": "node scripts/db-verify.cjs",
    "test:f5": "node scripts/harness-docker.cjs --suite=f5 --keep-db",
    "test:f8": "node scripts/harness-docker.cjs --suite=f8",
    "test:staging": "node test/staging-smoke.cjs",
    "backup": "node scripts/backup.cjs",
    "test:integration:local": "node scripts/check-integration-local.cjs",
    "test:original:local": "node test/run-e2e.cjs --browser --spec=original-integral.spec.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "google-auth-library": "^11.3.1",
    "nodemailer": "^10.2.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
